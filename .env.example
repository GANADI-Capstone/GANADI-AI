# Claude API Key (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here

# AI 모델 (random_split → dog/cat_best_random_split.pth)
MODEL_VERSION=random_split
MODEL_CHECKPOINT_DIR=models/classifier/checkpoints

# 추론 백엔드: pytorch | onnx | onnx_int8 (EC2 CPU: onnx_int8)
INFERENCE_BACKEND=onnx_int8

# Optional: AWS S3 설정
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=ap-northeast-2
